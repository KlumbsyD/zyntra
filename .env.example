# Copy to .env and fill in values. Never commit your real .env.

# ── Discord ──────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
TEXT_PREFIX=!

# ── Plex ─────────────────────────────────────────────────
# One of: token | oauth | path
PLEX_AUTH_METHOD=token
PLEX_URL=
PLEX_TOKEN=
PLEX_MUSIC_PATH=/music

# ── Web dashboard ────────────────────────────────────────
# REQUIRED to enable the dashboard. If unset or a weak default
# (changeme/password/admin), the dashboard refuses to start and
# only the bot runs. Use a long, random value.
WEB_PASSWORD=
WEB_PORT=3333

# ── Bot settings ─────────────────────────────────────────
DEFAULT_VOLUME=0.5
STATE_DIR=/data
ANTI_DUPLICATE=true
ANTI_DUPLICATE_MEMORY=10
DEBUG=false

# ── Nested copy extras (Lidarr + community playlists) ────
COMMUNITY_PLAYLIST_THRESHOLD=3
LIDARR_URL=
LIDARR_API_KEY=
LIDARR_ROOT_FOLDER=/data
TIMEZONE=UTC
